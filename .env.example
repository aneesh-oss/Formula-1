# New Relic Free Tier OTLP Ingestion Key
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Local Ingestion & Analytical Storage Paths
FASTF1_CACHE_DIR=data/fastf1_cache
LAKEHOUSE_DIR=data/lakehouse

# Google Stitch API Key (https://stitch.withgoogle.com/)
# Used by UI Designer agent to sync screens and design tokens directly
STITCH_API_KEY=your_stitch_api_key_here

# Google Maps Platform (Maps JavaScript API / 3D Tiles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment
ENVIRONMENT=development
PORT=8000

